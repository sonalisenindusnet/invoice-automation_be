# Copy this file to ".env" (same folder) and fill in real values there.
# Do NOT rename/edit THIS file with real credentials — copy it first.
# Never paste the contents of your real .env file into a chat, ticket, or anywhere else.

EMAIL_ADDRESS=your-account@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# MIS project-info lookup API (see config/mis_api_config.json for the
# non-secret base URL/endpoint). Sent as an "x-api-key" header (changed
# 2026-08-12 -- was a Bearer JWT before). Update it here and restart the
# server whenever it changes/rotates (no auto-refresh built, per instruction).
MIS_API_KEY=your-mis-api-key

# Used by src/mailer/llm_email_drafter.py (added 2026-08-14) to draft the
# client-facing invoice email body with Gemini. If this is missing/invalid,
# email drafting automatically falls back to the plain static template --
# it never blocks an invoice from going out.
GEMINI_API_KEY=your-gemini-api-key
# Optional -- override which Gemini model is used (defaults to
# gemini-2.0-flash if unset). Set this to whatever model name is actually
# available/current on your account.
GEMINI_MODEL=gemini-3.6-flash
PAYMENT_DUE_DAYS=7
DRAFT_POLL_INTERVAL_SECONDS=300